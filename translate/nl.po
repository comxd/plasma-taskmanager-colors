msgid "Settings"
msgstr "Instellingen"

#: contents/ui/main.qml
msgid "Nyan Cat"
msgstr "Nyan Cat"

#: contents/ui/main.qml
msgid "About"
msgstr "Over"

#: contents/ui/main.qml
msgid "Disabled — toggle switch above to enable"
msgstr "Uitgeschakeld — schakel de schakelaar hierboven in"

#: contents/ui/main.qml
msgid "Hide widget from panel"
msgstr "Widget verbergen in paneel"

#: contents/ui/main.qml
msgid "About Task Manager Colors"
msgstr "Over Taakbeheer kleuren"

#: contents/ui/main.qml
msgid "Must be placed in a panel"
msgstr "Moet in een paneel geplaatst worden"

#: contents/ui/main.qml
msgid "Disabled"
msgstr "Uitgeschakeld"

#: contents/ui/main.qml
msgid "%1 application(s) colored"
msgstr "%1 toepassing(en) gekleurd"

#: contents/ui/main.qml
msgid "Click to assign colors"
msgstr "Klik om kleuren toe te wijzen"

#: contents/ui/tabs/AboutTab.qml
msgid "Version %1"
msgstr "Versie %1"

#: contents/ui/tabs/AboutTab.qml
msgid ""
"Per-application and per-window color overlays for the Plasma task manager."
msgstr ""
"Kleuroverlays per toepassing en per venster voor het Plasma-taakbeheer."

#: contents/ui/tabs/AboutTab.qml
msgid "Enjoying this plasmoid? Support its development!"
msgstr "Bevalt dit plasmoid? Steun de ontwikkeling!"

#: contents/ui/tabs/AboutTab.qml
msgid ""
"This plasmoid is developed and maintained on my free time. If you find it "
"useful, a small donation helps keep it going!"
msgstr ""
"Dit plasmoid wordt in mijn vrije tijd ontwikkeld en onderhouden. Als u het "
"nuttig vindt, helpt een kleine donatie om het draaiende te houden!"

#: contents/ui/tabs/AboutTab.qml
msgid "Buy me a coffee"
msgstr "Buy me a coffee"

#: contents/ui/tabs/ApplicationsTab.qml
msgid ""
"Assign a persistent color to each application. The color applies to all "
"windows of that application."
msgstr ""
"Ken een vaste kleur toe aan elke toepassing. De kleur geldt voor alle "
"vensters van die toepassing."

#: contents/ui/tabs/ApplicationsTab.qml
msgid "No tasks detected — open some windows to assign colors."
msgstr "Geen taken gedetecteerd — open vensters om kleuren toe te wijzen."

#: contents/ui/tabs/ApplicationsTab.qml
msgid "(pinned)"
msgstr "(vastgezet)"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Color for: %1"
msgstr "Kleur voor: %1"

#: contents/ui/tabs/ApplicationsTab.qml contents/ui/tabs/WindowsTab.qml
msgid "Nyan Cat rainbow effect"
msgstr "Nyan Cat regenboogeffect"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Remove color"
msgstr "Kleur verwijderen"

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Configure the rainbow animation effect. Enable it per-app using the switch "
"next to each color button in the Applications tab."
msgstr ""
"Configureer het regenbooganimatie-effect. Schakel het per app in met de "
"schakelaar naast elke kleurknop in het tabblad Toepassingen."

#: contents/ui/tabs/NyanTab.qml
msgid "Speed"
msgstr "Snelheid"

#: contents/ui/tabs/NyanTab.qml
msgid "Duration of one full rainbow cycle. Lower = faster."
msgstr "Duur van een volledige regenboogcyclus. Lager = sneller."

#: contents/ui/tabs/NyanTab.qml
msgid "Style"
msgstr "Stijl"

#: contents/ui/tabs/NyanTab.qml
msgid "Flat"
msgstr "Vlak"

#: contents/ui/tabs/NyanTab.qml
msgid "Wave"
msgstr "Golf"

#: contents/ui/tabs/NyanTab.qml
msgid "Original"
msgstr "Origineel"

#: contents/ui/tabs/NyanTab.qml
msgid "Color-shifting flat bands."
msgstr "Vlakke banden met kleurverschuiving."

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Faithful to the original Nyan Cat rainbow: constant-width bands with "
"alternating vertical offset."
msgstr ""
"Trouw aan de originele Nyan Cat-regenboog: banden van gelijke breedte met "
"afwisselende verticale verschuiving."

#: contents/ui/tabs/NyanTab.qml
msgid "Wavy band edges with flowing animation."
msgstr "Golvende bandranden met vloeiende animatie."

#: contents/ui/tabs/NyanTab.qml
msgid "Animation FPS"
msgstr "Animatie-FPS"

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Refresh interval in ms. Lower = smoother but more CPU. Default: 150ms (~7 "
"fps)."
msgstr ""
"Verversingsinterval in ms. Lager = vloeiender maar meer CPU. Standaard: "
"150ms (~7 fps)."

#: contents/ui/tabs/NyanTab.qml
msgid "Preview"
msgstr "Voorbeeld"

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure how colors are displayed on task manager entries."
msgstr "Configureer hoe kleuren worden weergegeven op taakbeheer-items."

#: contents/ui/tabs/SettingsTab.qml
msgid "Appearance"
msgstr "Uiterlijk"

#: contents/ui/tabs/SettingsTab.qml
msgid "Mode"
msgstr "Modus"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay is rendered on each task."
msgstr "Hoe de kleuroverlay op elke taak wordt gerenderd."

#: contents/ui/tabs/SettingsTab.qml
msgid "Thickness"
msgstr "Dikte"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border/line thickness. Auto reads from theme SVG margins."
msgstr "Rand/lijndikte. Auto leest uit de SVG-marges van het thema."

#: contents/ui/tabs/SettingsTab.qml
msgid "Opacity"
msgstr "Dekking"

#: contents/ui/tabs/SettingsTab.qml
msgid "Color overlay intensity."
msgstr "Achtergrondvulintensiteit."

#: contents/ui/tabs/SettingsTab.qml
msgid "Corners"
msgstr "Hoeken"

#: contents/ui/tabs/SettingsTab.qml
msgid "Corner rounding. Auto matches current theme. Max = perfect circle."
msgstr "Hoekafronding. Auto past bij het huidige thema. Max = perfecte cirkel."

#: contents/ui/tabs/SettingsTab.qml
msgid "Behavior"
msgstr "Gedrag"

#: contents/ui/tabs/SettingsTab.qml
msgid "Show color on pinned favorites even when no window is open."
msgstr "Kleur tonen op vastgezette favorieten, ook zonder geopende vensters."

#: contents/ui/tabs/SettingsTab.qml
msgid "Keep color on focused task"
msgstr "Kleur behouden op gefocuste taak"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Overlay stays visible above Plasma's focus highlight (80% bg + top accent "
"line)."
msgstr ""
"Overlay blijft zichtbaar boven Plasma's focusmarkering (80% achtergrond + "
"bovenste accentlijn)."

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized windows:"
msgstr "Geminimaliseerde vensters:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Normal (no change)"
msgstr "Normaal (geen wijziging)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide overlay"
msgstr "Overlay verbergen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Dim overlay"
msgstr "Overlay dimmen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate (grayscale)"
msgstr "Ontverzadigen (grijstinten)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom style…"
msgstr "Aangepaste stijl…"

#: contents/ui/tabs/SettingsTab.qml
msgid "How color overlays behave on minimized windows."
msgstr "Gedrag van kleuroverlays bij geminimaliseerde vensters."

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style:"
msgstr "Geminimaliseerde stijl:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Use a different display mode when windows are minimized."
msgstr ""
"Een andere weergavemodus gebruiken wanneer vensters geminimaliseerd zijn."

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Current normal mode is disabled — use Dim or Desaturate for same-shape "
"effects."
msgstr ""
"De huidige normale modus is uitgeschakeld — gebruik Dimmen of Ontverzadigen "
"voor effecten met dezelfde vorm."

#: contents/ui/tabs/SettingsTab.qml
msgid "Effect:"
msgstr "Effect:"

#: contents/ui/tabs/SettingsTab.qml
msgid "None"
msgstr "Geen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate overlay"
msgstr "Overlay ontverzadigen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Widget"
msgstr "Widget"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide widget icon from panel"
msgstr "Widgetpictogram verbergen in paneel"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"The widget icon is hidden. Colors continue to work. To show it again: right-"
"click the panel → Enter Edit Mode → the widget will reappear → right-click "
"it → uncheck this option. Tip: a global shortcut can open this popup even "
"when hidden."
msgstr ""
"Het widgetpictogram is verborgen. De kleuren blijven werken. Om het weer te "
"tonen: klik met de rechtermuisknop op het paneel → Bewerkmodus activeren → "
"de widget verschijnt weer → klik er met de rechtermuisknop op → schakel deze "
"optie uit. Tip: een globale sneltoets kan deze popup openen, ook als de "
"widget verborgen is."

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Hides the widget icon from the panel. Colors continue to work normally in "
"the background. Also available via right-click on the widget icon. Tip: set "
"a global shortcut to open this popup even when hidden."
msgstr ""
"Verbergt het widgetpictogram in het paneel. De kleuren blijven normaal op de "
"achtergrond werken. Ook beschikbaar via rechtermuisknop op het "
"widgetpictogram. Tip: stel een globale sneltoets in om deze popup te openen, "
"ook als de widget verborgen is."

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure Keyboard Shortcut…"
msgstr "Sneltoets configureren…"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Opens the widget configuration dialog where you can set a global shortcut to "
"toggle this popup."
msgstr ""
"Opent het configuratievenster van de widget waar u een globale sneltoets "
"kunt instellen om deze popup te schakelen."

#: contents/ui/tabs/WindowsTab.qml
msgid ""
"Temporarily override the color of a specific window. Overrides are lost when "
"the window is closed."
msgstr ""
"Overschrijf tijdelijk de kleur van een specifiek venster. Overschrijvingen "
"gaan verloren bij sluiten van het venster."

#: contents/ui/tabs/WindowsTab.qml
msgid "No windows detected — open some windows to use per-window overrides."
msgstr ""
"Geen vensters gedetecteerd — open vensters voor vensterspecifieke "
"overschrijvingen."

#: contents/ui/tabs/WindowsTab.qml
msgid "Window color override"
msgstr "Vensterkleur overschrijven"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset to app color"
msgstr "Herstellen naar app-kleur"

