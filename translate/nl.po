#: contents/ui/main.qml contents/ui/tabs/AboutTab.qml
msgid "Task Manager Colors"
msgstr "Taakbeheer kleuren"

#: contents/ui/main.qml
msgid "Applications"
msgstr "Toepassingen"

#: contents/ui/main.qml
msgid "Windows (%1)"
msgstr "Vensters (%1)"

