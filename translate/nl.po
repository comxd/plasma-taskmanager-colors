msgid "Focused window"
msgstr "Gefocust venster"

#: contents/ui/tabs/SettingsTab.qml
msgid "Theme decoration (focused):"
msgstr "Themadecoratie (gefocust):"

#: contents/ui/tabs/SettingsTab.qml
msgid "Controls the Plasma theme decoration on focused task buttons."
msgstr "Beheert de Plasma-themadecoratie op gefocuste taakknoppen."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused window:"
msgstr "Gefocust venster:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide overlay"
msgstr "Overlay verbergen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Background (80%)"
msgstr "Achtergrond (80%)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom style…"
msgstr "Aangepaste stijl…"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay behaves when a task has focus."
msgstr "Hoe de kleuroverlay zich gedraagt wanneer een taak focus heeft."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style:"
msgstr "Focusstijl:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for focused windows."
msgstr "Randdikte voor gefocuste vensters."

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom opacity"
msgstr "Aangepaste dekking"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom corners"
msgstr "Aangepaste hoeken"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized window"
msgstr "Geminimaliseerd venster"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized windows:"
msgstr "Geminimaliseerde vensters:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Normal (no change)"
msgstr "Normaal (geen wijziging)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Dim overlay"
msgstr "Overlay dimmen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate (grayscale)"
msgstr "Ontverzadigen (grijstinten)"

#: contents/ui/tabs/SettingsTab.qml
msgid "How color overlays behave on minimized windows."
msgstr "Gedrag van kleuroverlays bij geminimaliseerde vensters."

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturation style:"
msgstr "Desaturatiestijl:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Grayscale"
msgstr "Grijstinten"

#: contents/ui/tabs/SettingsTab.qml
msgid "Partial (keep hue)"
msgstr "Gedeeltelijk (tint behouden)"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Grayscale removes all color. Partial keeps the hue but reduces saturation."
msgstr ""
"Grijstinten verwijdert alle kleur. Gedeeltelijk behoudt de tint maar "
"vermindert de verzadiging."

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style:"
msgstr "Geminimaliseerde stijl:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Use a different display mode when windows are minimized."
msgstr ""
"Een andere weergavemodus gebruiken wanneer vensters geminimaliseerd zijn."

#: contents/ui/tabs/SettingsTab.qml
msgid "Effect:"
msgstr "Effect:"

#: contents/ui/tabs/SettingsTab.qml
msgid "None"
msgstr "Geen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate overlay"
msgstr "Overlay ontverzadigen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for minimized windows."
msgstr "Randdikte voor geminimaliseerde vensters."

#: contents/ui/tabs/SettingsTab.qml
msgid "Hover window"
msgstr "Hover-venster"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hover window:"
msgstr "Hover-venster:"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay behaves when hovering over a task."
msgstr "Hoe de kleuroverlay zich gedraagt bij het zweven over een taak."

#: contents/ui/tabs/SettingsTab.qml
msgid "Hover style:"
msgstr "Hover-stijl:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for hovered windows."
msgstr "Randdikte voor vensters bij zweven."

#: contents/ui/tabs/SettingsTab.qml
msgid "Theme decoration (hover):"
msgstr "Themadecoratie (hover):"

#: contents/ui/tabs/SettingsTab.qml
msgid "Controls the Plasma theme decoration when hovering over task buttons."
msgstr "Beheert de Plasma-themadecoratie bij het zweven over taakknoppen."

#: contents/ui/tabs/SettingsTab.qml
msgid "Behavior"
msgstr "Gedrag"

#: contents/ui/tabs/SettingsTab.qml
msgid "Pinned apps:"
msgstr "Vastgezette apps:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Always colored"
msgstr "Altijd gekleurd"

#: contents/ui/tabs/SettingsTab.qml
msgid "Only when running"
msgstr "Alleen bij uitvoering"

#: contents/ui/tabs/SettingsTab.qml
msgid "Show color on pinned favorites even when no window is open."
msgstr "Kleur tonen op vastgezette favorieten, ook zonder geopende vensters."

#: contents/ui/tabs/SettingsTab.qml
msgid "Auto color:"
msgstr "Automatische kleur:"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Automatically extract and apply a dominant color from each application icon. "
"Only applies to apps without a manual color or Nyan mode."
msgstr ""
"Automatisch een dominante kleur uit elk toepassingspictogram extraheren en "
"toepassen. Geldt alleen voor apps zonder handmatige kleur of Nyan-modus."

#: contents/ui/tabs/SettingsTab.qml
msgid "Extracting colors…"
msgstr "Kleuren extraheren…"

#: contents/ui/tabs/SettingsTab.qml
msgid "Refresh auto colors"
msgstr "Automatische kleuren vernieuwen"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Re-extract icon colors for all applications. Useful after changing icon "
"themes."
msgstr ""
"Pictogramkleuren opnieuw extraheren voor alle toepassingen. Handig na het "
"wijzigen van het pictogramthema."

#: contents/ui/tabs/SettingsTab.qml
msgid "Widget"
msgstr "Widget"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide widget icon from panel"
msgstr "Widgetpictogram verbergen in paneel"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"The widget icon is hidden. Colors continue to work. To show it again: right-"
"click the panel → Enter Edit Mode → the widget will reappear → right-click "
"it → uncheck this option. Tip: a global shortcut can open this popup even "
"when hidden."
msgstr ""
"Het widgetpictogram is verborgen. De kleuren blijven werken. Om het weer te "
"tonen: klik met de rechtermuisknop op het paneel → Bewerkmodus activeren → "
"de widget verschijnt weer → klik er met de rechtermuisknop op → schakel deze "
"optie uit. Tip: een globale sneltoets kan deze popup openen, ook als de "
"widget verborgen is."

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Hides the widget icon from the panel. Colors continue to work normally in "
"the background. Also available via right-click on the widget icon. Tip: set "
"a global shortcut to open this popup even when hidden."
msgstr ""
"Verbergt het widgetpictogram in het paneel. De kleuren blijven normaal op de "
"achtergrond werken. Ook beschikbaar via rechtermuisknop op het "
"widgetpictogram. Tip: stel een globale sneltoets in om deze popup te openen, "
"ook als de widget verborgen is."

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure Keyboard Shortcut…"
msgstr "Sneltoets configureren…"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Opens the widget configuration dialog where you can set a global shortcut to "
"toggle this popup."
msgstr ""
"Opent het configuratievenster van de widget waar u een globale sneltoets "
"kunt instellen om deze popup te schakelen."

#: contents/ui/tabs/SettingsTab.qml
msgid "Select mode"
msgstr "Modus selecteren"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style"
msgstr "Geminimaliseerde stijl"

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style"
msgstr "Focusstijl"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hover style"
msgstr "Hover-stijl"

#: contents/ui/tabs/WindowsTab.qml
msgid ""
"Temporarily override the color of a specific window. Overrides are lost when "
"the window is closed."
msgstr ""
"Overschrijf tijdelijk de kleur van een specifiek venster. Overschrijvingen "
"gaan verloren bij sluiten van het venster."

#: contents/ui/tabs/WindowsTab.qml
msgid "No windows detected — open some windows to use per-window overrides."
msgstr ""
"Geen vensters gedetecteerd — open vensters voor vensterspecifieke "
"overschrijvingen."

#: contents/ui/tabs/WindowsTab.qml
msgid "Custom window override"
msgstr "Aangepaste vensteroverschrijving"

#: contents/ui/tabs/WindowsTab.qml
msgid "Custom nyan override"
msgstr "Aangepaste nyan-overschrijving"

#: contents/ui/tabs/WindowsTab.qml
msgid "Nyan inherited from app — click to override"
msgstr "Nyan overgenomen van app — klik om te overschrijven"

#: contents/ui/tabs/WindowsTab.qml
msgid "Auto-extracted from icon — click to override"
msgstr "Automatisch uit pictogram geëxtraheerd — klik om te overschrijven"

#: contents/ui/tabs/WindowsTab.qml
msgid "Color inherited from app — click to override"
msgstr "Kleur overgenomen van app — klik om te overschrijven"

#: contents/ui/tabs/WindowsTab.qml
msgid "Click to set color"
msgstr "Klik om kleur in te stellen"

#: contents/ui/tabs/WindowsTab.qml
msgid "inherit"
msgstr "overgenomen"

#: contents/ui/tabs/WindowsTab.qml
msgid "Window color override"
msgstr "Vensterkleur overschrijven"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset to app color"
msgstr "Herstellen naar app-kleur"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset window overrides"
msgstr "Vensteroverschrijvingen resetten"

