msgstr "Barvy:"

#: contents/ui/configGeneral.qml
msgid "%1 application(s) configured"
msgstr "Nakonfigurováno %1 aplikací"

#: contents/ui/configGeneral.qml
msgid "No colors configured"
msgstr "Žádné barvy nenastaveny"

#: contents/ui/configGeneral.qml
msgid ""
"All settings and color management are available in the widget popup. Click "
"the widget icon in the panel to open it."
msgstr "Všechna nastavení a správa barev jsou dostupné v okně widgetu. Klikněte na ikonu widgetu na panelu pro otevření."

#: contents/ui/main.qml contents/ui/tabs/AboutTab.qml
msgid "Task Manager Colors"
msgstr "Barvy správce úloh"

#: contents/ui/main.qml
msgid "Applications"
msgstr "Aplikace"

#: contents/ui/main.qml
msgid "Windows (%1)"
msgstr "Okna (%1)"

#: contents/ui/main.qml
msgid "Settings"
msgstr "Nastavení"

#: contents/ui/main.qml
msgid "About"
msgstr "O aplikaci"

#: contents/ui/main.qml
msgid "Disabled — toggle switch above to enable"
msgstr "Zakázáno — zapněte přepínač výše"

#: contents/ui/main.qml
msgid "Hide widget from panel"
msgstr "Skrýt widget z panelu"

#: contents/ui/main.qml
msgid "About Task Manager Colors"
msgstr "O aplikaci Barvy správce úloh"

#: contents/ui/main.qml
msgid "Must be placed in a panel"
msgstr "Musí být umístěn na panelu"

#: contents/ui/main.qml
msgid "Disabled"
msgstr "Zakázáno"

#: contents/ui/main.qml
msgid "%1 application(s) colored"
msgstr "Obarveno %1 aplikací"

#: contents/ui/main.qml
msgid "Click to assign colors"
msgstr "Klikněte pro přiřazení barev"

#: contents/ui/tabs/AboutTab.qml
msgid "Version %1"
msgstr "Verze %1"

#: contents/ui/tabs/AboutTab.qml
msgid ""
"Per-application and per-window color overlays for the Plasma task manager."
msgstr "Barevné překryvy podle aplikací a oken pro správce úloh Plasma."

#: contents/ui/tabs/AboutTab.qml
msgid "Enjoying this plasmoid? Support its development!"
msgstr "Líbí se vám tento plazmoid? Podpořte jeho vývoj!"

#: contents/ui/tabs/AboutTab.qml
msgid ""
"This plasmoid is developed and maintained on my free time. If you find it "
"useful, a small donation helps keep it going!"
msgstr ""
"Tento plazmoid je vyvíjen a udržován v mém volném čase. Pokud ho považujete "
"za užitečný, malý příspěvek pomůže v jeho dalším vývoji!"

#: contents/ui/tabs/AboutTab.qml
msgid "Buy me a coffee"
msgstr "Buy me a coffee"

#: contents/ui/tabs/ApplicationsTab.qml
msgid ""
"Assign a persistent color to each application. The color applies to all "
"windows of that application."
msgstr ""
"Přiřaďte trvalou barvu každé aplikaci. Barva se použije na všechna okna dané "
"aplikace."

#: contents/ui/tabs/ApplicationsTab.qml
msgid "No tasks detected — open some windows to assign colors."
msgstr "Nebyly zjištěny žádné úlohy — otevřete okna pro přiřazení barev."

#: contents/ui/tabs/ApplicationsTab.qml
msgid "(pinned)"
msgstr "(připnuto)"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Color for: %1"
msgstr "Barva pro: %1"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Remove color"
msgstr "Odebrat barvu"

#: contents/ui/tabs/ApplicationsTab.qml contents/ui/tabs/WindowsTab.qml
msgid "Click again to confirm"
msgstr "Klikněte znovu pro potvrzení"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Reset all colors"
msgstr "Obnovit všechny barvy"

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Configure the rainbow animation effect. Enable it per-app using the switch "
"next to each color button in the Applications tab."
msgstr ""
"Nastavte duhový animační efekt. Zapněte ho pro každou aplikaci pomocí "
"přepínače vedle každého tlačítka barvy na kartě Aplikace."

#: contents/ui/tabs/NyanTab.qml
msgid "Speed"
msgstr "Rychlost"

#: contents/ui/tabs/NyanTab.qml
msgid "Duration of one full rainbow cycle. Lower = faster."
msgstr "Délka jednoho úplného duhového cyklu. Nižší = rychlejší."

#: contents/ui/tabs/NyanTab.qml
msgid "Style"
msgstr "Styl"

#: contents/ui/tabs/NyanTab.qml
msgid "Flat"
msgstr "Plochý"

#: contents/ui/tabs/NyanTab.qml
msgid "Wave"
msgstr "Vlna"

#: contents/ui/tabs/NyanTab.qml
msgid "Original"
msgstr "Původní"

#: contents/ui/tabs/NyanTab.qml
msgid "Color-shifting flat bands."
msgstr "Ploché pásy s měnícími se barvami."

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Faithful to the original Nyan Cat rainbow: constant-width bands with "
"alternating vertical offset."
msgstr ""
"Věrná původní duze Nyan Cat: pásy konstantní šířky s alternujícím "
"vertikálním posunem."

#: contents/ui/tabs/NyanTab.qml
msgid "Wavy band edges with flowing animation."
msgstr "Zvlněné okraje pásů s plynulou animací."

#: contents/ui/tabs/NyanTab.qml
msgid "Animation FPS"
msgstr "FPS animace"

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Refresh interval in ms. Lower = smoother but more CPU. Default: 150ms (~7 "
"fps)."
msgstr ""
"Interval obnovování v ms. Nižší = plynulejší, ale více CPU. Výchozí: 150ms "
"(~7 fps)."

#: contents/ui/tabs/NyanTab.qml
msgid "Preview"
msgstr "Náhled"

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure how colors are displayed on task manager entries."
msgstr "Nastavte způsob zobrazení barev na položkách správce úloh."

#: contents/ui/tabs/SettingsTab.qml
msgid "Appearance"
msgstr "Vzhled"

#: contents/ui/tabs/SettingsTab.qml
msgid "Mode"
msgstr "Režim"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay is rendered on each task."
msgstr "Způsob vykreslení barevného překryvu na každé úloze."

#: contents/ui/tabs/SettingsTab.qml
msgid "Thickness"
msgstr "Tloušťka"

#: contents/ui/tabs/SettingsTab.qml
msgid "Auto"
msgstr "Auto"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border/line thickness. Auto reads from theme SVG margins."
msgstr "Tloušťka okraje/čáry. Auto čte z SVG okrajů motivu."

#: contents/ui/tabs/SettingsTab.qml
msgid "Opacity"
msgstr "Průhlednost"

#: contents/ui/tabs/SettingsTab.qml
msgid "Color overlay intensity."
msgstr "Intenzita vyplnění pozadí."

#: contents/ui/tabs/SettingsTab.qml
msgid "Corners"
msgstr "Rohy"

#: contents/ui/tabs/SettingsTab.qml
msgid "Corner rounding. Auto matches current theme. Max = perfect circle."
msgstr "Zaoblení rohů. Auto odpovídá aktuálnímu motivu. Max = dokonalý kruh."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused window"
msgstr "Zaměřené okno"

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused window:"
msgstr "Zaměřené okno:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide overlay"
msgstr "Skrýt překrytí"

#: contents/ui/tabs/SettingsTab.qml
msgid "Background (80%)"
msgstr "Pozadí (80%)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom style…"
msgstr "Vlastní styl…"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay behaves when a task has focus."
msgstr "Jak se barevný překryv chová, když má úloha fokus."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style:"
msgstr "Styl zaměření:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for focused windows."
msgstr "Tloušťka okraje pro zaměřená okna."

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom opacity"
msgstr "Vlastní krytí"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom corners"
msgstr "Vlastní rohy"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized window"
msgstr "Minimalizované okno"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized windows:"
msgstr "Minimalizovaná okna:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Normal (no change)"
msgstr "Normální (beze změny)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Dim overlay"
msgstr "Ztlumit překrytí"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate (grayscale)"
msgstr "Odbarvit (odstíny šedi)"

#: contents/ui/tabs/SettingsTab.qml
msgid "How color overlays behave on minimized windows."
msgstr "Chování barevných překrytí u minimalizovaných oken."

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style:"
msgstr "Styl minimalizovaných:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Use a different display mode when windows are minimized."
msgstr "Použít jiný režim zobrazení, když jsou okna minimalizovaná."

#: contents/ui/tabs/SettingsTab.qml
msgid "Effect:"
msgstr "Efekt:"

#: contents/ui/tabs/SettingsTab.qml
msgid "None"
msgstr "Žádný"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate overlay"
msgstr "Odbarvit překrytí"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for minimized windows."
msgstr "Tloušťka okraje pro minimalizovaná okna."

#: contents/ui/tabs/SettingsTab.qml
msgid "Behavior"
msgstr "Chování"

#: contents/ui/tabs/SettingsTab.qml
msgid "Pinned apps:"
msgstr "Připnuté aplikace:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Always colored"
msgstr "Vždy obarvené"

#: contents/ui/tabs/SettingsTab.qml
msgid "Only when running"
msgstr "Pouze za běhu"

#: contents/ui/tabs/SettingsTab.qml
msgid "Show color on pinned favorites even when no window is open."
msgstr "Zobrazit barvu na připnutých oblíbených i bez otevřených oken."

#: contents/ui/tabs/SettingsTab.qml
msgid "Widget"
msgstr "Widget"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide widget icon from panel"
msgstr "Skrýt ikonu widgetu z panelu"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"The widget icon is hidden. Colors continue to work. To show it again: right-"
"click the panel → Enter Edit Mode → the widget will reappear → right-click "
"it → uncheck this option. Tip: a global shortcut can open this popup even "
"when hidden."
msgstr ""
"Ikona widgetu je skrytá. Barvy nadále fungují. Pro opětovné zobrazení: "
"klikněte pravým tlačítkem na panel → Vstoupit do režimu úprav → widget se "
"znovu zobrazí → klikněte na něj pravým tlačítkem → odškrtněte tuto možnost. "
"Tip: globální klávesová zkratka může otevřít toto vyskakovací okno i když je "
"widget skrytý."

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Hides the widget icon from the panel. Colors continue to work normally in "
"the background. Also available via right-click on the widget icon. Tip: set "
"a global shortcut to open this popup even when hidden."
msgstr ""
"Skryje ikonu widgetu z panelu. Barvy nadále normálně fungují na pozadí. Také "
"dostupné přes pravý klik na ikonu widgetu. Tip: nastavte globální klávesovou "
"zkratku pro otevření tohoto vyskakovacího okna i když je widget skrytý."

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure Keyboard Shortcut…"
msgstr "Nastavit klávesovou zkratku…"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Opens the widget configuration dialog where you can set a global shortcut to "
"toggle this popup."
msgstr ""
"Otevře dialogové okno konfigurace widgetu, kde můžete nastavit globální "
"klávesovou zkratku pro přepínání tohoto vyskakovacího okna."

#: contents/ui/tabs/SettingsTab.qml
msgid "Select mode"
msgstr "Vybrat režim"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style"
msgstr "Styl minimalizovaných"

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style"
msgstr "Styl zaměření"

#: contents/ui/tabs/WindowsTab.qml
msgid ""
"Temporarily override the color of a specific window. Overrides are lost when "
"the window is closed."
msgstr ""
"Dočasně přepsat barvu konkrétního okna. Přepsání se ztratí po zavření okna."

#: contents/ui/tabs/WindowsTab.qml
msgid "No windows detected — open some windows to use per-window overrides."
msgstr "Nebyla zjištěna žádná okna — otevřete okna pro přepsání po oknech."

#: contents/ui/tabs/WindowsTab.qml
msgid "Window color override"
msgstr "Přepsání barvy okna"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset to app color"
msgstr "Obnovit na barvu aplikace"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset window overrides"
msgstr "Obnovit přepsání oken"
