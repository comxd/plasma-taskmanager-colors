#: contents/ui/tabs/SettingsTab.qml
msgid "Background (80%)"
msgstr "Fondo (80%)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom style…"
msgstr "Estilo personalizado…"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay behaves when a task has focus."
msgstr ""
"Cómo se comporta la superposición de color cuando una tarea tiene el foco."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style:"
msgstr "Estilo enfocado:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for focused windows."
msgstr "Grosor del borde para ventanas enfocadas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom opacity"
msgstr "Opacidad personalizada"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom corners"
msgstr "Esquinas personalizadas"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized window"
msgstr "Ventana minimizada"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized windows:"
msgstr "Ventanas minimizadas:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Normal (no change)"
msgstr "Normal (sin cambios)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Dim overlay"
msgstr "Atenuar superposición"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate (grayscale)"
msgstr "Desaturar (escala de grises)"

#: contents/ui/tabs/SettingsTab.qml
msgid "How color overlays behave on minimized windows."
msgstr ""
"Comportamiento de las superposiciones de color en ventanas minimizadas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturation style:"
msgstr "Estilo de desaturación:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Grayscale"
msgstr "Escala de grises"

#: contents/ui/tabs/SettingsTab.qml
msgid "Partial (keep hue)"
msgstr "Parcial (conservar tono)"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Grayscale removes all color. Partial keeps the hue but reduces saturation."
msgstr ""
"Escala de grises elimina todo el color. Parcial conserva el tono pero reduce "
"la saturación."

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style:"
msgstr "Estilo minimizado:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Use a different display mode when windows are minimized."
msgstr ""
"Usar un modo de visualización diferente cuando las ventanas están "
"minimizadas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Effect:"
msgstr "Efecto:"

#: contents/ui/tabs/SettingsTab.qml
msgid "None"
msgstr "Ninguno"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate overlay"
msgstr "Desaturar superposición"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for minimized windows."
msgstr "Grosor del borde para ventanas minimizadas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Hover window"
msgstr "Ventana al pasar"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hover window:"
msgstr "Ventana al pasar:"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay behaves when hovering over a task."
msgstr ""
"Comportamiento de la superposición de color al pasar el cursor sobre una "
"tarea."

#: contents/ui/tabs/SettingsTab.qml
msgid "Hover style:"
msgstr "Estilo de hover:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for hovered windows."
msgstr "Grosor del borde para ventanas al pasar el cursor."

#: contents/ui/tabs/SettingsTab.qml
msgid "Theme decoration (hover):"
msgstr "Decoración del tema (hover):"

#: contents/ui/tabs/SettingsTab.qml
msgid "Controls the Plasma theme decoration when hovering over task buttons."
msgstr "Controla la decoración del tema Plasma al pasar el cursor sobre los botones de tareas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Behavior"
msgstr "Comportamiento"

#: contents/ui/tabs/SettingsTab.qml
msgid "Pinned apps:"
msgstr "Apps fijadas:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Always colored"
msgstr "Siempre coloreadas"

#: contents/ui/tabs/SettingsTab.qml
msgid "Only when running"
msgstr "Solo en ejecución"

#: contents/ui/tabs/SettingsTab.qml
msgid "Show color on pinned favorites even when no window is open."
msgstr "Mostrar color en favoritos fijados incluso sin ventanas abiertas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Auto color:"
msgstr "Color automático:"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Automatically extract and apply a dominant color from each application icon. "
"Only applies to apps without a manual color or Nyan mode."
msgstr ""
"Extraer y aplicar automáticamente un color dominante del icono de cada "
"aplicación. Solo se aplica a apps sin color manual ni modo Nyan."

#: contents/ui/tabs/SettingsTab.qml
msgid "Extracting colors…"
msgstr "Extrayendo colores…"

#: contents/ui/tabs/SettingsTab.qml
msgid "Refresh auto colors"
msgstr "Actualizar colores automáticos"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Re-extract icon colors for all applications. Useful after changing icon "
"themes."
msgstr ""
"Volver a extraer los colores de los iconos de todas las aplicaciones. Útil "
"después de cambiar el tema de iconos."

#: contents/ui/tabs/SettingsTab.qml
msgid "Widget"
msgstr "Widget"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide widget icon from panel"
msgstr "Ocultar icono del widget del panel"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"The widget icon is hidden. Colors continue to work. To show it again: right-"
"click the panel → Enter Edit Mode → the widget will reappear → right-click "
"it → uncheck this option. Tip: a global shortcut can open this popup even "
"when hidden."
msgstr ""
"El icono del widget está oculto. Los colores siguen funcionando. Para "
"mostrarlo de nuevo: clic derecho en el panel → Entrar en modo edición → el "
"widget reaparecerá → clic derecho sobre él → desmarcar esta opción. Consejo: "
"un atajo global puede abrir este popup incluso cuando está oculto."

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Hides the widget icon from the panel. Colors continue to work normally in "
"the background. Also available via right-click on the widget icon. Tip: set "
"a global shortcut to open this popup even when hidden."
msgstr ""
"Oculta el icono del widget del panel. Los colores siguen funcionando "
"normalmente en segundo plano. También disponible mediante clic derecho en el "
"icono del widget. Consejo: establezca un atajo global para abrir este popup "
"incluso cuando está oculto."

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure Keyboard Shortcut…"
msgstr "Configurar atajo de teclado…"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Opens the widget configuration dialog where you can set a global shortcut to "
"toggle this popup."
msgstr ""
"Abre el diálogo de configuración del widget donde puede establecer un atajo "
"global para alternar este popup."

#: contents/ui/tabs/SettingsTab.qml
msgid "Select mode"
msgstr "Seleccionar modo"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style"
msgstr "Estilo minimizado"

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style"
msgstr "Estilo enfocado"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hover style"
msgstr "Estilo de hover"

#: contents/ui/tabs/WindowsTab.qml
msgid ""
"Temporarily override the color of a specific window. Overrides are lost when "
"the window is closed."
msgstr ""
"Anular temporalmente el color de una ventana específica. Las anulaciones se "
"pierden al cerrar la ventana."

#: contents/ui/tabs/WindowsTab.qml
msgid "No windows detected — open some windows to use per-window overrides."
msgstr ""
"No se detectaron ventanas — abra ventanas para usar anulaciones por ventana."

#: contents/ui/tabs/WindowsTab.qml
msgid "Custom window override"
msgstr "Anulación de ventana personalizada"

#: contents/ui/tabs/WindowsTab.qml
msgid "Custom nyan override"
msgstr "Anulación nyan personalizada"

#: contents/ui/tabs/WindowsTab.qml
msgid "Nyan inherited from app — click to override"
msgstr "Nyan heredado de la aplicación — clic para anular"

#: contents/ui/tabs/WindowsTab.qml
msgid "Auto-extracted from icon — click to override"
msgstr "Extraído automáticamente del icono — clic para anular"

#: contents/ui/tabs/WindowsTab.qml
msgid "Color inherited from app — click to override"
msgstr "Color heredado de la aplicación — clic para anular"

#: contents/ui/tabs/WindowsTab.qml
msgid "Click to set color"
msgstr "Clic para establecer color"

#: contents/ui/tabs/WindowsTab.qml
msgid "inherit"
msgstr "heredado"

#: contents/ui/tabs/WindowsTab.qml
msgid "Window color override"
msgstr "Anulación de color de ventana"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset to app color"
msgstr "Restablecer al color de la aplicación"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset window overrides"
msgstr "Restablecer anulaciones de ventana"

