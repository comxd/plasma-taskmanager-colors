msgid "Settings"
msgstr "Einstellungen"

#: contents/ui/main.qml
msgid "About"
msgstr "Über"

#: contents/ui/main.qml
msgid "Disabled — toggle switch above to enable"
msgstr "Deaktiviert — Schalter oben aktivieren"

#: contents/ui/main.qml
msgid "Hide widget from panel"
msgstr "Widget in der Leiste ausblenden"

#: contents/ui/main.qml
msgid "About Task Manager Colors"
msgstr "Über Fensterleiste Farben"

#: contents/ui/main.qml
msgid "Must be placed in a panel"
msgstr "Muss in einer Leiste platziert werden"

#: contents/ui/main.qml
msgid "Disabled"
msgstr "Deaktiviert"

#: contents/ui/main.qml
msgid "%1 application(s) colored"
msgstr "%1 Anwendung(en) eingefärbt"

#: contents/ui/main.qml
msgid "Click to assign colors"
msgstr "Klicken, um Farben zuzuweisen"

#: contents/ui/tabs/AboutTab.qml
msgid "Version %1"
msgstr "Version %1"

#: contents/ui/tabs/AboutTab.qml
msgid ""
"Per-application and per-window color overlays for the Plasma task manager."
msgstr ""
"Anwendungs- und fensterspezifische Farbüberlagerungen für die Plasma-"
"Fensterleiste."

#: contents/ui/tabs/AboutTab.qml
msgid "Enjoying this plasmoid? Support its development!"
msgstr "Gefällt Ihnen dieses Plasmoid? Unterstützen Sie seine Entwicklung!"

#: contents/ui/tabs/AboutTab.qml
msgid ""
"This plasmoid is developed and maintained on my free time. If you find it "
"useful, a small donation helps keep it going!"
msgstr ""
"Dieses Plasmoid wird in meiner Freizeit entwickelt und gepflegt. Wenn Sie es "
"nützlich finden, hilft eine kleine Spende, es am Laufen zu halten!"

#: contents/ui/tabs/AboutTab.qml
msgid "Buy me a coffee"
msgstr "Buy me a coffee"

#: contents/ui/tabs/ApplicationsTab.qml
msgid ""
"Assign a persistent color to each application. The color applies to all "
"windows of that application."
msgstr ""
"Weisen Sie jeder Anwendung eine dauerhafte Farbe zu. Die Farbe gilt für alle "
"Fenster dieser Anwendung."

#: contents/ui/tabs/ApplicationsTab.qml
msgid "No tasks detected — open some windows to assign colors."
msgstr "Keine Aufgaben erkannt — öffnen Sie Fenster, um Farben zuzuweisen."

#: contents/ui/tabs/ApplicationsTab.qml
msgid "(pinned)"
msgstr "(angeheftet)"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Color for: %1"
msgstr "Farbe für: %1"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Remove color"
msgstr "Farbe entfernen"

#: contents/ui/tabs/ApplicationsTab.qml contents/ui/tabs/WindowsTab.qml
msgid "Click again to confirm"
msgstr "Zur Bestätigung erneut klicken"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Reset all colors"
msgstr "Alle Farben zurücksetzen"

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Configure the rainbow animation effect. Enable it per-app using the switch "
"next to each color button in the Applications tab."
msgstr ""
"Den Regenbogen-Animationseffekt konfigurieren. Aktivieren Sie ihn pro "
"Anwendung mit dem Schalter neben jeder Farbtaste im Tab Anwendungen."

#: contents/ui/tabs/NyanTab.qml
msgid "Speed"
msgstr "Geschwindigkeit"

#: contents/ui/tabs/NyanTab.qml
msgid "Duration of one full rainbow cycle. Lower = faster."
msgstr "Dauer eines vollständigen Regenbogenzyklus. Niedriger = schneller."

#: contents/ui/tabs/NyanTab.qml
msgid "Style"
msgstr "Stil"

#: contents/ui/tabs/NyanTab.qml
msgid "Flat"
msgstr "Flach"

#: contents/ui/tabs/NyanTab.qml
msgid "Wave"
msgstr "Welle"

#: contents/ui/tabs/NyanTab.qml
msgid "Original"
msgstr "Original"

#: contents/ui/tabs/NyanTab.qml
msgid "Color-shifting flat bands."
msgstr "Flache Bänder mit Farbverschiebung."

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Faithful to the original Nyan Cat rainbow: constant-width bands with "
"alternating vertical offset."
msgstr ""
"Originalgetreue Nyan-Cat-Regenbogenstreifen: gleichmäßig breite Bänder mit "
"abwechselndem vertikalen Versatz."

#: contents/ui/tabs/NyanTab.qml
msgid "Wavy band edges with flowing animation."
msgstr "Wellenförmige Bandkanten mit fließender Animation."

#: contents/ui/tabs/NyanTab.qml
msgid "Animation FPS"
msgstr "Animations-FPS"

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Refresh interval in ms. Lower = smoother but more CPU. Default: 150ms (~7 "
"fps)."
msgstr ""
"Aktualisierungsintervall in ms. Niedriger = flüssiger, aber mehr CPU. "
"Standard: 150ms (~7 fps)."

#: contents/ui/tabs/NyanTab.qml
msgid "Preview"
msgstr "Vorschau"

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure how colors are displayed on task manager entries."
msgstr ""
"Konfigurieren Sie, wie Farben auf den Einträgen der Fensterleiste angezeigt "
"werden."

#: contents/ui/tabs/SettingsTab.qml
msgid "Appearance"
msgstr "Erscheinungsbild"

#: contents/ui/tabs/SettingsTab.qml
msgid "Mode"
msgstr "Modus"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay is rendered on each task."
msgstr "Wie die Farbüberlagerung auf jeder Aufgabe gerendert wird."

#: contents/ui/tabs/SettingsTab.qml
msgid "Thickness"
msgstr "Stärke"

#: contents/ui/tabs/SettingsTab.qml
msgid "Auto"
msgstr "Auto"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border/line thickness. Auto reads from theme SVG margins."
msgstr "Rahmen-/Linienstärke. Auto liest aus den SVG-Rändern des Designs."

#: contents/ui/tabs/SettingsTab.qml
msgid "Opacity"
msgstr "Deckkraft"

#: contents/ui/tabs/SettingsTab.qml
msgid "Color overlay intensity."
msgstr "Hintergrundfüllungsintensität."

#: contents/ui/tabs/SettingsTab.qml
msgid "Corners"
msgstr "Ecken"

#: contents/ui/tabs/SettingsTab.qml
msgid "Corner rounding. Auto matches current theme. Max = perfect circle."
msgstr ""
"Eckenabrundung. Auto passt zum aktuellen Design. Max = perfekter Kreis."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused window"
msgstr "Fokussiertes Fenster"

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused window:"
msgstr "Fokussiertes Fenster:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide overlay"
msgstr "Überlagerung ausblenden"

#: contents/ui/tabs/SettingsTab.qml
msgid "Background (80%)"
msgstr "Hintergrund (80%)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom style…"
msgstr "Benutzerdefinierter Stil…"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay behaves when a task has focus."
msgstr ""
"Wie sich die Farbüberlagerung verhält, wenn eine Aufgabe den Fokus hat."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style:"
msgstr "Fokus-Stil:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for focused windows."
msgstr "Rahmenstärke für fokussierte Fenster."

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom opacity"
msgstr "Eigene Deckkraft"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom corners"
msgstr "Eigene Ecken"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized window"
msgstr "Minimiertes Fenster"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized windows:"
msgstr "Minimierte Fenster:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Normal (no change)"
msgstr "Normal (keine Änderung)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Dim overlay"
msgstr "Überlagerung abdunkeln"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate (grayscale)"
msgstr "Entsättigen (Graustufen)"

#: contents/ui/tabs/SettingsTab.qml
msgid "How color overlays behave on minimized windows."
msgstr "Verhalten der Farbüberlagerungen bei minimierten Fenstern."

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style:"
msgstr "Minimiert-Stil:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Use a different display mode when windows are minimized."
msgstr "Einen anderen Anzeigemodus verwenden, wenn Fenster minimiert sind."

#: contents/ui/tabs/SettingsTab.qml
msgid "Effect:"
msgstr "Effekt:"

#: contents/ui/tabs/SettingsTab.qml
msgid "None"
msgstr "Kein"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate overlay"
msgstr "Überlagerung entsättigen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for minimized windows."
msgstr "Rahmenstärke für minimierte Fenster."

#: contents/ui/tabs/SettingsTab.qml
msgid "Behavior"
msgstr "Verhalten"

#: contents/ui/tabs/SettingsTab.qml
msgid "Pinned apps:"
msgstr "Angeheftete Apps:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Always colored"
msgstr "Immer eingefärbt"

#: contents/ui/tabs/SettingsTab.qml
msgid "Only when running"
msgstr "Nur wenn aktiv"

#: contents/ui/tabs/SettingsTab.qml
msgid "Show color on pinned favorites even when no window is open."
msgstr ""
"Farbe auf angehefteten Favoriten anzeigen, auch wenn kein Fenster geöffnet "
"ist."

#: contents/ui/tabs/SettingsTab.qml
msgid "Widget"
msgstr "Widget"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide widget icon from panel"
msgstr "Widget-Symbol in der Leiste ausblenden"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"The widget icon is hidden. Colors continue to work. To show it again: right-"
"click the panel → Enter Edit Mode → the widget will reappear → right-click "
"it → uncheck this option. Tip: a global shortcut can open this popup even "
"when hidden."
msgstr ""
"Das Widget-Symbol ist ausgeblendet. Die Farben funktionieren weiterhin. Zum "
"erneuten Anzeigen: Rechtsklick auf die Leiste → Bearbeitungsmodus aktivieren "
"→ das Widget wird wieder angezeigt → Rechtsklick darauf → diese Option "
"deaktivieren. Tipp: Ein globales Tastenkürzel kann dieses Popup auch im "
"ausgeblendeten Zustand öffnen."

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Hides the widget icon from the panel. Colors continue to work normally in "
"the background. Also available via right-click on the widget icon. Tip: set "
"a global shortcut to open this popup even when hidden."
msgstr ""
"Blendet das Widget-Symbol in der Leiste aus. Die Farben funktionieren "
"weiterhin normal im Hintergrund. Auch per Rechtsklick auf das Widget-Symbol "
"verfügbar. Tipp: Legen Sie ein globales Tastenkürzel fest, um dieses Popup "
"auch im ausgeblendeten Zustand zu öffnen."

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure Keyboard Shortcut…"
msgstr "Tastenkürzel konfigurieren…"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Opens the widget configuration dialog where you can set a global shortcut to "
"toggle this popup."
msgstr ""
"Öffnet den Konfigurationsdialog des Widgets, in dem Sie ein globales "
"Tastenkürzel zum Umschalten dieses Popups festlegen können."

#: contents/ui/tabs/SettingsTab.qml
msgid "Select mode"
msgstr "Modus auswählen"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style"
msgstr "Minimiert-Stil"

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style"
msgstr "Fokus-Stil"

#: contents/ui/tabs/WindowsTab.qml
msgid ""
"Temporarily override the color of a specific window. Overrides are lost when "
"the window is closed."
msgstr ""
"Farbe eines bestimmten Fensters vorübergehend überschreiben. "
"Überschreibungen gehen beim Schließen des Fensters verloren."

#: contents/ui/tabs/WindowsTab.qml
msgid "No windows detected — open some windows to use per-window overrides."
msgstr ""
"Keine Fenster erkannt — öffnen Sie Fenster für fensterspezifische "
"Überschreibungen."

#: contents/ui/tabs/WindowsTab.qml
msgid "Window color override"
msgstr "Fensterfarbe überschreiben"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset to app color"
msgstr "Auf App-Farbe zurücksetzen"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset window overrides"
msgstr "Fenster-Überschreibungen zurücksetzen"

