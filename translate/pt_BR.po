msgstr "Sobre"

#: contents/ui/main.qml
msgid "Disabled — toggle switch above to enable"
msgstr "Desativado — ative o interruptor acima"

#: contents/ui/main.qml
msgid "Hide widget from panel"
msgstr "Ocultar widget do painel"

#: contents/ui/main.qml
msgid "About Task Manager Colors"
msgstr "Sobre Cores do gerenciador de tarefas"

#: contents/ui/main.qml
msgid "Must be placed in a panel"
msgstr "Deve ser colocado em um painel"

#: contents/ui/main.qml
msgid "Disabled"
msgstr "Desativado"

#: contents/ui/main.qml
msgid "%1 application(s) colored"
msgstr "%1 aplicativo(s) colorido(s)"

#: contents/ui/main.qml
msgid "Click to assign colors"
msgstr "Clique para atribuir cores"

#: contents/ui/tabs/AboutTab.qml
msgid "Version %1"
msgstr "Versão %1"

#: contents/ui/tabs/AboutTab.qml
msgid ""
"Per-application and per-window color overlays for the Plasma task manager."
msgstr ""
"Sobreposições de cor por aplicativo e por janela para o gerenciador de "
"tarefas do Plasma."

#: contents/ui/tabs/AboutTab.qml
msgid "Enjoying this plasmoid? Support its development!"
msgstr "Gostando deste plasmoide? Apoie seu desenvolvimento!"

#: contents/ui/tabs/AboutTab.qml
msgid ""
"This plasmoid is developed and maintained on my free time. If you find it "
"useful, a small donation helps keep it going!"
msgstr ""
"Este plasmoide é desenvolvido e mantido no meu tempo livre. Se você o achar "
"útil, uma pequena doação ajuda a mantê-lo!"

#: contents/ui/tabs/AboutTab.qml
msgid "Buy me a coffee"
msgstr "Buy me a coffee"

#: contents/ui/tabs/ApplicationsTab.qml
msgid ""
"Assign a persistent color to each application. The color applies to all "
"windows of that application."
msgstr ""
"Atribuir uma cor persistente a cada aplicativo. A cor se aplica a todas as "
"janelas desse aplicativo."

#: contents/ui/tabs/ApplicationsTab.qml
msgid "No tasks detected — open some windows to assign colors."
msgstr "Nenhuma tarefa detectada — abra janelas para atribuir cores."

#: contents/ui/tabs/ApplicationsTab.qml
msgid "(pinned)"
msgstr "(fixado)"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Auto color disabled for this app — click to re-enable"
msgstr "Cor automática desativada para este app — clique para reativar"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Color auto-extracted from icon — click to disable"
msgstr "Cor extraída automaticamente do ícone — clique para desativar"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Extracting color from icon…"
msgstr "Extraindo cor do ícone…"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Auto color overridden by manual color"
msgstr "Cor automática substituída por cor manual"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "auto"
msgstr "auto"

#: contents/ui/tabs/ApplicationsTab.qml contents/ui/tabs/WindowsTab.qml
msgid "nyan"
msgstr "nyan"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Color for: %1"
msgstr "Cor para: %1"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Remove color"
msgstr "Remover cor"

#: contents/ui/tabs/ApplicationsTab.qml contents/ui/tabs/WindowsTab.qml
msgid "Click again to confirm"
msgstr "Clique novamente para confirmar"

#: contents/ui/tabs/ApplicationsTab.qml
msgid "Reset all colors"
msgstr "Redefinir todas as cores"

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Configure the rainbow animation effect. Enable it per-app using the switch "
"next to each color button in the Applications tab."
msgstr ""
"Configurar o efeito de animação arco-íris. Ative-o por aplicativo usando o "
"interruptor ao lado de cada botão de cor na aba Aplicativos."

#: contents/ui/tabs/NyanTab.qml
msgid "Speed"
msgstr "Velocidade"

#: contents/ui/tabs/NyanTab.qml
msgid "Duration of one full rainbow cycle. Lower = faster."
msgstr "Duração de um ciclo arco-íris completo. Menor = mais rápido."

#: contents/ui/tabs/NyanTab.qml
msgid "Style"
msgstr "Estilo"

#: contents/ui/tabs/NyanTab.qml
msgid "Flat"
msgstr "Plano"

#: contents/ui/tabs/NyanTab.qml
msgid "Wave"
msgstr "Onda"

#: contents/ui/tabs/NyanTab.qml
msgid "Original"
msgstr "Original"

#: contents/ui/tabs/NyanTab.qml
msgid "Color-shifting flat bands."
msgstr "Faixas planas com mudança de cor."

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Faithful to the original Nyan Cat rainbow: constant-width bands with "
"alternating vertical offset."
msgstr ""
"Fiel ao arco-íris original do Nyan Cat: faixas de largura constante com "
"deslocamento vertical alternado."

#: contents/ui/tabs/NyanTab.qml
msgid "Wavy band edges with flowing animation."
msgstr "Bordas de faixa onduladas com animação fluida."

#: contents/ui/tabs/NyanTab.qml
msgid "Animation FPS"
msgstr "FPS da animação"

#: contents/ui/tabs/NyanTab.qml
msgid ""
"Refresh interval in ms. Lower = smoother but more CPU. Default: 150ms (~7 "
"fps)."
msgstr ""
"Intervalo de atualização em ms. Menor = mais suave, mas mais CPU. Padrão: "
"150ms (~7 fps)."

#: contents/ui/tabs/NyanTab.qml
msgid "Preview"
msgstr "Pré-visualização"

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure how colors are displayed on task manager entries."
msgstr ""
"Configurar como as cores são exibidas nas entradas do gerenciador de tarefas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Appearance"
msgstr "Aparência"

#: contents/ui/tabs/SettingsTab.qml
msgid "Mode"
msgstr "Modo"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay is rendered on each task."
msgstr "Como a sobreposição de cor é renderizada em cada tarefa."

#: contents/ui/tabs/SettingsTab.qml
msgid "Thickness"
msgstr "Espessura"

#: contents/ui/tabs/SettingsTab.qml
msgid "Auto"
msgstr "Auto"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border/line thickness. Auto reads from theme SVG margins."
msgstr "Espessura da borda/linha. Auto lê as margens SVG do tema."

#: contents/ui/tabs/SettingsTab.qml
msgid "Opacity"
msgstr "Opacidade"

#: contents/ui/tabs/SettingsTab.qml
msgid "Color overlay intensity."
msgstr "Intensidade do preenchimento do plano de fundo."

#: contents/ui/tabs/SettingsTab.qml
msgid "Corners"
msgstr "Cantos"

#: contents/ui/tabs/SettingsTab.qml
msgid "Corner rounding. Auto matches current theme. Max = perfect circle."
msgstr ""
"Arredondamento dos cantos. Auto corresponde ao tema atual. Máx = círculo "
"perfeito."

#: contents/ui/tabs/SettingsTab.qml
msgid "Soften colors"
msgstr "Suavizar cores"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Adapts colors to match the current theme brightness. Makes vivid colors less "
"harsh."
msgstr ""
"Adapta as cores ao brilho do tema atual. Torna as cores vivas menos "
"agressivas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Show window count indicators"
msgstr "Mostrar indicadores de contagem de janelas"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Show small segment dots when multiple windows are grouped under one task."
msgstr ""
"Mostrar pequenos pontos quando várias janelas estão agrupadas sob uma mesma "
"tarefa."

#: contents/ui/tabs/SettingsTab.qml
msgid "Theme decoration (inactive)"
msgstr "Decoração do tema (inativo)"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Select which Plasma theme borders to show on inactive task buttons. Uncheck "
"all to hide decoration."
msgstr "Selecionar quais bordas do tema Plasma exibir nos botões de tarefas inativos. Desmarcar todos para ocultar a decoração."

#: contents/ui/tabs/SettingsTab.qml
msgid "Top border"
msgstr "Borda superior"

#: contents/ui/tabs/SettingsTab.qml
msgid "Bottom border"
msgstr "Borda inferior"

#: contents/ui/tabs/SettingsTab.qml
msgid "Left border"
msgstr "Borda esquerda"

#: contents/ui/tabs/SettingsTab.qml
msgid "Right border"
msgstr "Borda direita"

#: contents/ui/tabs/SettingsTab.qml
msgid "Theme decoration (hover)"
msgstr "Decoração do tema (hover)"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Select which Plasma theme borders to show when hovering. Uncheck all to hide "
"decoration."
msgstr "Selecionar quais bordas do tema Plasma exibir ao passar o mouse. Desmarcar todos para ocultar a decoração."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused window"
msgstr "Janela em foco"

#: contents/ui/tabs/SettingsTab.qml
msgid "Theme decoration (focused)"
msgstr "Decoração do tema (em foco)"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Select which Plasma theme borders to show on focused tasks. Uncheck all to "
"hide decoration."
msgstr "Selecionar quais bordas do tema Plasma exibir nas tarefas com foco. Desmarcar todos para ocultar a decoração."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused window:"
msgstr "Janela em foco:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide overlay"
msgstr "Ocultar sobreposição"

#: contents/ui/tabs/SettingsTab.qml
msgid "Background (80%)"
msgstr "Fundo (80%)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom style…"
msgstr "Estilo personalizado…"

#: contents/ui/tabs/SettingsTab.qml
msgid "How the color overlay behaves when a task has focus."
msgstr "Como a sobreposição de cor se comporta quando uma tarefa está em foco."

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style:"
msgstr "Estilo em foco:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for focused windows."
msgstr "Espessura da borda para janelas em foco."

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom opacity"
msgstr "Opacidade personalizada"

#: contents/ui/tabs/SettingsTab.qml
msgid "Custom corners"
msgstr "Cantos personalizados"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized window"
msgstr "Janela minimizada"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized windows:"
msgstr "Janelas minimizadas:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Normal (no change)"
msgstr "Normal (sem alteração)"

#: contents/ui/tabs/SettingsTab.qml
msgid "Dim overlay"
msgstr "Escurecer sobreposição"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate (grayscale)"
msgstr "Dessaturar (escala de cinza)"

#: contents/ui/tabs/SettingsTab.qml
msgid "How color overlays behave on minimized windows."
msgstr "Comportamento das sobreposições de cor em janelas minimizadas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturation style:"
msgstr "Estilo de dessaturação:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Grayscale"
msgstr "Escala de cinza"

#: contents/ui/tabs/SettingsTab.qml
msgid "Partial (keep hue)"
msgstr "Parcial (manter matiz)"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Grayscale removes all color. Partial keeps the hue but reduces saturation."
msgstr ""
"Escala de cinza remove toda a cor. Parcial mantém o matiz mas reduz a "
"saturação."

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style:"
msgstr "Estilo minimizado:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Use a different display mode when windows are minimized."
msgstr ""
"Usar um modo de exibição diferente quando as janelas estão minimizadas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Effect:"
msgstr "Efeito:"

#: contents/ui/tabs/SettingsTab.qml
msgid "None"
msgstr "Nenhum"

#: contents/ui/tabs/SettingsTab.qml
msgid "Desaturate overlay"
msgstr "Dessaturar sobreposição"

#: contents/ui/tabs/SettingsTab.qml
msgid "Border thickness for minimized windows."
msgstr "Espessura da borda para janelas minimizadas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Behavior"
msgstr "Comportamento"

#: contents/ui/tabs/SettingsTab.qml
msgid "Pinned apps:"
msgstr "Apps fixados:"

#: contents/ui/tabs/SettingsTab.qml
msgid "Always colored"
msgstr "Sempre coloridos"

#: contents/ui/tabs/SettingsTab.qml
msgid "Only when running"
msgstr "Apenas em execução"

#: contents/ui/tabs/SettingsTab.qml
msgid "Show color on pinned favorites even when no window is open."
msgstr "Mostrar cor em favoritos fixados mesmo sem janelas abertas."

#: contents/ui/tabs/SettingsTab.qml
msgid "Auto color:"
msgstr "Cor automática:"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Automatically extract and apply a dominant color from each application icon. "
"Only applies to apps without a manual color or Nyan mode."
msgstr ""
"Extrair e aplicar automaticamente uma cor dominante do ícone de cada "
"aplicativo. Aplica-se apenas a apps sem cor manual ou modo Nyan."

#: contents/ui/tabs/SettingsTab.qml
msgid "Extracting colors…"
msgstr "Extraindo cores…"

#: contents/ui/tabs/SettingsTab.qml
msgid "Refresh auto colors"
msgstr "Atualizar cores automáticas"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Re-extract icon colors for all applications. Useful after changing icon "
"themes."
msgstr ""
"Reextrair as cores dos ícones de todos os aplicativos. Útil após trocar o "
"tema de ícones."

#: contents/ui/tabs/SettingsTab.qml
msgid "Widget"
msgstr "Widget"

#: contents/ui/tabs/SettingsTab.qml
msgid "Hide widget icon from panel"
msgstr "Ocultar ícone do widget do painel"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"The widget icon is hidden. Colors continue to work. To show it again: right-"
"click the panel → Enter Edit Mode → the widget will reappear → right-click "
"it → uncheck this option. Tip: a global shortcut can open this popup even "
"when hidden."
msgstr ""
"O ícone do widget está oculto. As cores continuam funcionando. Para exibi-lo "
"novamente: clique com o botão direito no painel → Entrar no modo de edição → "
"o widget reaparecerá → clique com o botão direito nele → desmarque esta "
"opção. Dica: um atalho global pode abrir este popup mesmo quando oculto."

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Hides the widget icon from the panel. Colors continue to work normally in "
"the background. Also available via right-click on the widget icon. Tip: set "
"a global shortcut to open this popup even when hidden."
msgstr ""
"Oculta o ícone do widget do painel. As cores continuam funcionando "
"normalmente em segundo plano. Também disponível via clique com o botão "
"direito no ícone do widget. Dica: defina um atalho global para abrir este "
"popup mesmo quando oculto."

#: contents/ui/tabs/SettingsTab.qml
msgid "Configure Keyboard Shortcut…"
msgstr "Configurar atalho de teclado…"

#: contents/ui/tabs/SettingsTab.qml
msgid ""
"Opens the widget configuration dialog where you can set a global shortcut to "
"toggle this popup."
msgstr ""
"Abre a caixa de diálogo de configuração do widget onde você pode definir um "
"atalho global para alternar este popup."

#: contents/ui/tabs/SettingsTab.qml
msgid "Select mode"
msgstr "Selecionar modo"

#: contents/ui/tabs/SettingsTab.qml
msgid "Minimized style"
msgstr "Estilo minimizado"

#: contents/ui/tabs/SettingsTab.qml
msgid "Focused style"
msgstr "Estilo em foco"

#: contents/ui/tabs/WindowsTab.qml
msgid ""
"Temporarily override the color of a specific window. Overrides are lost when "
"the window is closed."
msgstr ""
"Substituir temporariamente a cor de uma janela específica. As substituições "
"são perdidas ao fechar a janela."

#: contents/ui/tabs/WindowsTab.qml
msgid "No windows detected — open some windows to use per-window overrides."
msgstr ""
"Nenhuma janela detectada — abra janelas para usar substituições por janela."

#: contents/ui/tabs/WindowsTab.qml
msgid "Custom window override"
msgstr "Substituição de janela personalizada"

#: contents/ui/tabs/WindowsTab.qml
msgid "Custom nyan override"
msgstr "Substituição nyan personalizada"

#: contents/ui/tabs/WindowsTab.qml
msgid "Nyan inherited from app — click to override"
msgstr "Nyan herdado do aplicativo — clique para substituir"

#: contents/ui/tabs/WindowsTab.qml
msgid "Auto-extracted from icon — click to override"
msgstr "Extraído automaticamente do ícone — clique para substituir"

#: contents/ui/tabs/WindowsTab.qml
msgid "Color inherited from app — click to override"
msgstr "Cor herdada do aplicativo — clique para substituir"

#: contents/ui/tabs/WindowsTab.qml
msgid "Click to set color"
msgstr "Clique para definir a cor"

#: contents/ui/tabs/WindowsTab.qml
msgid "inherit"
msgstr "herdado"

#: contents/ui/tabs/WindowsTab.qml
msgid "Window color override"
msgstr "Substituição de cor da janela"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset to app color"
msgstr "Redefinir para cor do aplicativo"

#: contents/ui/tabs/WindowsTab.qml
msgid "Reset window overrides"
msgstr "Redefinir substituições de janela"

