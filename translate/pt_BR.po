#: contents/ui/configGeneral.qml
msgid ""
"All settings and color management are available in the widget popup. Click "
"the widget icon in the panel to open it."
msgstr ""
"Todas as configurações e o gerenciamento de cores estão disponíveis no popup "
"do widget. Clique no ícone do widget no painel para abri-lo."

#: contents/ui/main.qml contents/ui/tabs/AboutTab.qml
msgid "Task Manager Colors"
msgstr "Cores do gerenciador de tarefas"

#: contents/ui/main.qml
msgid "Applications"
msgstr "Aplicativos"

#: contents/ui/main.qml
msgid "Windows (%1)"
msgstr "Janelas (%1)"

